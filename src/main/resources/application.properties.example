spring.application.name=ms-usuarios
server.port=8081

# Local: default con wallet en ~/oracle_wallets/foro.
# Docker/AWS: setear DB_URL (alias TNS o JDBC), DB_USERNAME, DB_PASSWORD.
spring.datasource.url=${DB_URL:jdbc:oracle:thin:@tg243br3udtanbr0_tp?TNS_ADMIN=${user.home}/oracle_wallets/foro}
spring.datasource.username=${DB_USERNAME:FORO_APP}
spring.datasource.password=${DB_PASSWORD:ForoApp123#fullstack}
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.OracleDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.connection-timeout=30000

jwt.secret=${JWT_SECRET:ForoJwtSecretKey2026DuocFullstackIIIExp1Semana2Segura}
jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}
